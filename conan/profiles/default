{% set os = detect_api.detect_os() %}
{% set arch = detect_api.detect_arch() %}
{% set compiler, version, compiler_exe = detect_api.detect_default_compiler() %}
{% set compiler_version = detect_api.default_compiler_version(compiler, version) %}

[settings]
os={{ os }}
arch={{ arch }}
build_type=Release
compiler={{ compiler }}
compiler.version={{ compiler_version }}
compiler.cppstd=20
compiler.libcxx={{ detect_api.detect_libcxx(compiler, version, compiler_exe) }}

[conf]
{# Pin the compiler executables by plain name so that dependencies resolve the same #}
{# compiler as the one detected from CC/CXX (not part of the package ID). #}
{% set cc_exe  = {"gcc": "gcc",  "clang": "clang",   "apple-clang": "clang"}.get(compiler) %}
{% set cxx_exe = {"gcc": "g++",  "clang": "clang++", "apple-clang": "clang++"}.get(compiler) %}
tools.build:compiler_executables={'c':'{{ cc_exe }}','cpp':'{{ cxx_exe }}'}
